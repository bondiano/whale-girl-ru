{
  "name": "whale-girl",
  "version": "0.4.0-ru.1",
  "type": "module",
  "description": "Домашний питомец в web-интерфейсе DSH (в духе QQ-питомца): живёт в правом нижнем углу, его можно тянуть, кормить и играть с ним; задачи, сессии и совместное время копятся в стаж, звания и воспоминания.",
  "main": "lib/index.mjs",
  "icon": "./icon.png",
  "files": [
    "lib/index.mjs",
    "lib/client.js",
    "lib/client",
    "lib/src",
    "lib/assets/characters",
    "lib/assets/manifest.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "README.en.md",
    "README.zh.md",
    "lib/web-route-auth.mjs"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "scripts": {
    "gates": "node scripts/gates/run.mjs",
    "gates:ci": "node scripts/gates/run.mjs --group ci",
    "test": "node --test 'tests/*.test.mjs'",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bondiano/whale-girl-ru.git"
  },
  "homepage": "https://github.com/bondiano/whale-girl-ru#readme",
  "bugs": {
    "url": "https://github.com/bondiano/whale-girl-ru/issues"
  }
}
