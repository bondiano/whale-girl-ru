{
  "name": "whale-girl",
  "version": "0.4.0-ru.2",
  "type": "module",
  "description": "Домашний питомец в web-интерфейсе DSH (в духе QQ-питомца): живёт в правом нижнем углу, его можно тянуть, кормить и играть с ним; задачи, сессии и совместное время копятся в стаж, звания и воспоминания.",
  "main": "dist/index.js",
  "icon": "./icon.png",
  "files": [
    "dist",
    "lib/client.js",
    "lib/assets/characters",
    "lib/assets/manifest.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "README.en.md",
    "README.zh.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "xstate": "^5.33.4"
  },
  "scripts": {
    "gates": "node scripts/gates/run.ts",
    "gates:ci": "node scripts/gates/run.ts --group ci",
    "test": "npm run build && node --test 'tests/*.test.ts'",
    "build:client": "node scripts/build-client.ts",
    "check:client": "node scripts/build-client.ts --check",
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "esbuild": "^0.28.1",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bondiano/whale-girl-ru.git"
  },
  "homepage": "https://github.com/bondiano/whale-girl-ru#readme",
  "bugs": {
    "url": "https://github.com/bondiano/whale-girl-ru/issues"
  },
  "engines": {
    "node": ">=24"
  }
}
