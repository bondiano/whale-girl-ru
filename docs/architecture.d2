direction: down

# whale-girl-ru: desktop-pet overlay in the DSH web UI, driven by a Host ledger of tasks and sessions

pet_user: "DSH web user\n[actor, drags and feeds]"
mf_overlay: "src/client pet overlay\n[self-rendered DOM, menu + chat bubble]"
dag_machines: "animation + conversation machines\n[XState v5 actors]"
xstate_dep: "xstate 5.33.4\n[createActor, runtime lock]"
mf_settingscard: "settings-card.ts\n[plugins.bundle.config slot, React]"
host_half: "src/index.ts apply\n[Cordis: jobs, agents, sessions, webServer]"
routes: "core/routes.ts endpoints\n[/state /interact /config /chat /voice /transcribe /sessions /events SSE /assets]"
ledger: "pet-state ledger\n[XP, levels, titles, memories]"
db_state: "state.json + sessions.json\n[DSH_HOME/data/whale-girl, atomic rename]"
jobs_events: "ctx.jobs.events + agent events\n[settled jobs, request errors]"
llm_svc: "ctx.get llm stream\n[host model service]"
ex_voice: "OpenAI-compatible voice API\n[STT + TTS via voice.baseUrl]"
ex_github: "api.github.com commits\n[update check, fetchJson]"
assets: "lib/assets sheets + manifest.json\n[sprite player, immutable cache]"
desktop: "desktop companion\n[Tauri, presence heartbeats]"

pet_user -> mf_overlay: "drag, feed, play, chat"
mf_overlay -> routes: "fetch + SSE event stream"
mf_overlay -> dag_machines: "state and expression selection"
dag_machines -> xstate_dep: "actors"
mf_overlay -> routes: "sprite sheets via /assets"
routes -> assets: "serves sanitized files"
mf_settingscard -> host_half: "settings namespace whale-girl"
host_half -> routes: "registers all endpoints"
routes -> ledger: "interact and chat mutations"
ledger -> db_state: "debounced atomic persist"
host_half -> jobs_events: "subscribes, owners all"
jobs_events -> ledger: "completed adds XP, failed counts"
routes -> llm_svc: "/chat streams model reply"
routes -> ex_voice: "/voice and /transcribe proxy"
host_half -> ex_github: "latest commit compare"
desktop -> routes: "presence heartbeat hides web pet"
