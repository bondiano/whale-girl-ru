#!/bin/sh
# Run the selected local gates. Keep hooks fast enough to avoid --no-verify;
# exhaustive coverage belongs to CI (scripts/gates/run.mjs --group ci).
set -e
cd "$(git rev-parse --show-toplevel)"
# With unstaged changes, remind contributors to stage explicit paths so git add -A
# cannot include another agent's work. Unstaged edits do not block commits;
# display the scope for the contributor to review.
if ! git diff --quiet; then
  echo "[pre-commit] 注意：存在未暂存改动（可能是并行 agent 在途修改），本次提交只含已暂存内容："
  git diff --name-only | sed 's/^/  - /'
  echo "[pre-commit] 请确认 add 范围显式、未误用 git add -A（见 AGENTS.md 并行/在途改动保护）。"
fi
node scripts/gates/run.mjs
